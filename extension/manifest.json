{
  "manifest_version": 3,
  "name": "Sleep Timer — Netflix & HBO Max",
  "version": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Sleep Timer",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.hbomax.com/*",
        "https://www.primevideo.com/*"
      ],
      "js": [
        "shared/i18n.js",
        "shared/settings.js",
        "shared/build.js",
        "shared/config.js",
        "core/timer.js",
        "core/playback-guard.js",
        "core/platform-registry.js",
        "core/media-binding.js",
        "adapters/netflix.js",
        "adapters/hbo.js",
        "adapters/prime-video.js",
        "ui/styles.js",
        "ui/timer-ui.js",
        "ui/stop-notice.js",
        "core/player-controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
